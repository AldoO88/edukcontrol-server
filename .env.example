# ============================================================
# EdukControl Backend — Environment Variables Example
# ============================================================
# Copy this file to `.env` and fill in the actual values.
# Never commit the real `.env` (it's gitignored).
# ============================================================

# ---------- Server ----------
NODE_ENV=development
PORT=5050

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/eduk_control

# ---------- JWT ----------
# Use a long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=replace_with_a_long_random_secret_string_at_least_32_chars

# ---------- Sign in with Apple (Guideline 4.8) ----------
# Audience esperado de los identityTokens de Apple = bundle id iOS de
# la app. Si falta, appleAuth.service.js hace fallback al mismo valor
# (net.edukcontrol.app), así que es opcional en la práctica pero queda
# documentado por si el bundle id cambia.
APPLE_CLIENT_ID=net.edukcontrol.app

# ---------- Push Notifications (Expo Push API) ----------
# Ya no usamos Firebase Admin SDK. El backend hace POST directo a
# la API pública de Expo. No requiere credentials.
# Opcional: sobreescribir si tenés un endpoint custom (tests, on-prem).
# EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=15
RATE_LIMIT_MAX=200

# ---------- Biometric device ----------
DEVICE_TRIGGER_API_KEY=bionmetricoTec47

# ---------- Timezone ----------
# Mexico City = UTC-6 → -360
ADMS_TZ_OFFSET_MINUTES=-360

# Ventana (minutos) de dedup cross-device de asistencia: taps del mismo alumno
# (cualquier dispositivo) dentro de esta ventana se tratan como duplicado.
# Default 5. Opcional.
ATTENDANCE_DEDUP_WINDOW_MIN=5

# ---------- CORS ----------
# Comma-separated list of allowed origins
ORIGIN=http://localhost:5173,http://localhost:8081,http://localhost:3000

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_WEBHOOK_SECRET=your_webhook_secret

# ============================================================
# Twilio WhatsApp Business API (OTPs)
# ============================================================
# Get these from https://console.twilio.com
# Account SID format: ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Auth Token (keep secret)
TWILIO_AUTH_TOKEN=your_auth_token

# The "from" WhatsApp number. In sandbox it's +14155238886 (Twilio's test
# number). In production it's the number Meta approved for your business.
TWILIO_WHATSAPP_FROM=+14155238886

# Content Template SID for the Authentication template, format
# HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx. Get it from Twilio Console →
# Messaging → Content Templates once Meta approves the template.
TWILIO_OTP_TEMPLATE_ID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL where Twilio will POST delivery/read/failed callbacks.
# In dev, use ngrok (https://your-ngrok-url.ngrok.io/auth/webhooks/twilio/whatsapp-status).
# In prod, use your real domain (https://api.edukcontrol.com/auth/webhooks/twilio/whatsapp-status).
TWILIO_STATUS_CALLBACK_URL=https://your-domain.com/auth/webhooks/twilio/whatsapp-status

# ---------- OTP_ECHO (solo testing, NUNCA en producción con usuarios) ----------
# Bypass temporal de Twilio: cuando está activo, los códigos OTP NO se
# envían por WhatsApp — se imprimen en consola del servidor (Render Logs)
# como `[otp-echo] purpose=... to=... code=123456`.
# Útil mientras la template de Meta no está aprobada para probar los
# flujos de activación (tutores) y recuperación de contraseña en la app.
# Valores válidos: unset (default, off) | 1 | true | console | yes | on
# ⚠️ Apagar siempre que la template de Meta esté aprobada y se hayan
# seteado las 5 vars TWILIO_* arriba. Ver services/whatsapp.service.js.
# OTP_ECHO=console

# ---------- ADMS terminal allowlist ----------
# Comma-separated ZKTeco serial numbers permitted to push to /iclock/*
ADMS_ALLOWED_SERIALS=

# JSON map {"<SN>":"<schoolId>"} binding each terminal to a school
ADMS_DEVICE_SCHOOL_MAP=

# ---------- Hikvision ISAPI HTTP Listening push ----------
# Token opaco en el path: la terminal Hikvision empuja eventos de
# autenticación a POST /hikvision/event/<HIKVISION_EVENT_TOKEN>.
# El firmware NO permite añadir cabeceras personalizadas, así que el token
# viaja en la URL (path, no query, para que no quede en logs de proxy).
# Generá uno con: `openssl rand -hex 32`
# Pegá el resultado en el campo "URL" del form HTTP Listening de la
# terminal como "/hikvision/event/<este-token>" y ponelo acá.
# Sin este env, el endpoint rechaza todas las peticiones (503 text/plain).
HIKVISION_EVENT_TOKEN=replace_with_openssl_rand_hex_32

# ---------- Push Notifications (Expo Push API) ----------
# Optional: configure if migrating from Firebase FCM. Expo Push API
# does not require server-side credentials — Expo handles delivery.
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send

# ---------- Cron jobs ----------
# CRON_TZ es OBLIGATORIO en producción: el cron usa esta zona para el schedule
# Y para los cálculos de cutoff de ausencias y chequeo de salidas. Sin esta var,
# el container (UTC en Render) mezclaría horas UTC con horas locales del turno
# y podría marcar faltas o salidas a deshoras.
CRON_ABSENCE_ENABLED=true
CRON_ABSENCE_SCHEDULE=0 8 * * 1-5
CRON_TZ=America/Mexico_City
CRON_CITATION_NO_SHOW_ENABLED=true

# ---------- Zona horaria del proceso ----------
# Opcional: server.js fija TZ=America/Mexico_City por defecto ANTES de cargar
# la app (toda la lógica de días/horarios asume hora de la escuela). Descomenta
# SOLO si la escuela está en otra zona; un TZ definido aquí se respeta.
# TZ=America/Mexico_City

# ---------- File uploads ----------
PENDING_UPLOADS_BACKEND=disk
PENDING_UPLOADS_DIR=/tmp/eduk-pending-uploads

# ---------- Misc ----------
# Public base URL used in Cloudinary notification_url for async uploads
# (optional — leave empty for synchronous mode in dev)
CLOUDINARY_NOTIFICATION_URL=

# URI de MongoDB Atlas (producción) — solo para clone-tenant-local.js.
# Nunca poner credenciales reales aquí ni en .env commiteado.
# MONGO_URI_ATLAS=mongodb+srv://user:pass@cluster0.xxx.mongodb.net/eduk-control
